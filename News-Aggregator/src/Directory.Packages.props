<Project>

  <!--
    Central Package Management (CPM): the single source of truth for package
    versions so they cannot drift between projects.

    All versions below were VERIFIED against nuget.org during scaffolding.
    Where the architecture docs (News-Aggregator/docs/05) pinned a different
    value, the discrepancy is flagged inline and the nearest real version used.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft Agent Framework (1.x line)">
    <!-- docs pinned 1.8.0; 1.9.0 is the current latest stable on nuget.org. -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.9.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.9.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions.AI (10.x line)">
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup Label="Model provider clients">
    <!-- docs said 'v4+'; 5.4.25 is current. OllamaApiClient implements IChatClient. -->
    <PackageVersion Include="OllamaSharp" Version="5.4.25" />
    <!-- Official OpenAI SDK; used for the OpenRouter (OpenAI-compatible) adapter. -->
    <PackageVersion Include="OpenAI" Version="2.10.0" />
  </ItemGroup>

  <ItemGroup Label=".NET Aspire (13.x line)">
    <!-- docs pinned 13.4.0; 13.4.2 is the current latest stable. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.2" />
    <!--
      P6: AppHost Ollama model bootstrap. CommunityToolkit Ollama HOSTING integration
      (AddOllama(...).AddModel(...) auto-pulls the model on startup so a single `dotnet run`
      can serve a digest). 13.4.0 is the current stable on the Aspire 13.4.x line. This
      reverses the earlier "no Community Toolkit" stance for HOSTING only — the chat CLIENT
      is still OllamaSharp inside Infrastructure (see docs/06 §6.1).
    -->
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="13.4.0" />
  </ItemGroup>

  <ItemGroup Label="Hosting / cross-cutting (10.x line)">
    <!--
      NOTE: docs (05) pinned ServiceDiscovery at 13.4.0 alongside Aspire, but on
      nuget.org Microsoft.Extensions.ServiceDiscovery tracks the .NET 10 line.
      Corrected to 10.6.0.
    -->
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <!-- IHealthCheck/HealthCheckResult for the model-provider probe (Infrastructure).
         Same assembly the AspNetCore shared framework ships at 10.0.8 → unifies in Web. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.8" />
    <PackageVersion Include="System.ServiceModel.Syndication" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup Label="Telemetry (OpenTelemetry)">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
  </ItemGroup>

  <ItemGroup Label="Test stack">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

  <!--
    Deliberately NOT referenced (per docs / Lean MVP scope):
      - Microsoft.Extensions.AI.Ollama         (deprecated)
      - CommunityToolkit.Aspire.OllamaSharp    (client integration; OllamaSharp is wired
                                               directly in Infrastructure — only the Ollama
                                               *hosting* toolkit is used, see above)
      - Aspire.Hosting.Redis / Aspire.StackExchange.Redis.DistributedCaching
                                               (Redis deferred — in-memory cache only)
  -->

</Project>
